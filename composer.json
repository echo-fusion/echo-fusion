{
    "name": "echo-fusion/echo-fusion",
    "description": "The EchoFusion skeleton with a complete example blog: accounts, posts, admin panel, JSON API. Install with: composer create-project echo-fusion/echo-fusion my-blog dev-blog",
    "keywords": [
        "framework",
        "skeleton",
        "project",
        "echofusion"
    ],
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/echo-fusion/echo-fusion",
    "authors": [
        {
            "name": "Amir Shadanfar",
            "email": "a.shadanfar.it@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/echo-fusion/echo-fusion/issues",
        "source": "https://github.com/echo-fusion/echo-fusion"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "echo-fusion/framework": "^1.2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.64",
        "echo-fusion/codestandard": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "serve": "@php -S localhost:8000 -t public",
        "console": "@php bin/console",
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "post-create-project-cmd": [
            "@php bin/console migrate",
            "@php bin/console db:seed",
            "@php -r \"echo PHP_EOL . 'Your blog is ready. Start it with: composer serve   (then open http://localhost:8000)' . PHP_EOL;\""
        ]
    },
    "scripts-descriptions": {
        "serve": "Start the PHP development server on http://localhost:8000",
        "console": "Run a console command: composer console -- route:list",
        "test": "Run the tests",
        "cs-check": "Check the code style",
        "cs-fix": "Fix the code style"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
